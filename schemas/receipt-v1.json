{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mnemorph/receipt-v1",
  "title": "Mnemorph public experiment receipt v1",
  "description": "Auditor truth is stored in a separate evaluation record and is never accepted in this public receipt.",
  "type": "object",
  "maxBytes": 2097152,
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptType",
    "experimentId",
    "createdAt",
    "source",
    "runtime",
    "platform",
    "compilerVersion",
    "randomizationMethod",
    "task",
    "config",
    "methods",
    "seedKeys",
    "runFingerprint",
    "snapshots",
    "rows",
    "rawRows",
    "rawRowEncoding",
    "outcomes",
    "failures",
    "claimStatus",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptType": { "const": "public-run" },
    "experimentId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["version", "hash", "hashKind"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "hashKind": { "enum": ["source-tree", "build-manifest"] }
      },
      "additionalProperties": false
    },
    "runtime": { "type": "string" },
    "platform": { "type": "string" },
    "compilerVersion": { "const": "bounded-assay-compiler-v1" },
    "randomizationMethod": { "const": "event-keyed-v1" },
    "task": { "type": "object" },
    "config": { "type": "object" },
    "methods": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "seedKeys": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 } },
    "runFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["masterSeed", "seedBlockIndex", "lineageId", "snapshotHash", "snapshot", "subjectId"],
        "properties": {
          "masterSeed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "seedBlockIndex": { "type": "integer", "minimum": 0 },
          "lineageId": { "type": "string" },
          "snapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "snapshot": { "type": "string" },
          "subjectId": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "rows": { "type": "array" },
    "rawRows": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 10,
        "maxItems": 10,
        "items": { "type": "integer", "minimum": 0 }
      }
    },
    "rawRowEncoding": {
      "type": "object",
      "required": ["fields", "methods", "seedBlocks", "arms", "stages", "contexts"],
      "properties": {
        "fields": { "type": "array", "items": { "type": "string" } },
        "methods": { "type": "array", "items": { "type": "string" } },
        "seedBlocks": { "type": "array", "items": { "type": "object" } },
        "arms": { "type": "array", "items": { "type": "string" } },
        "stages": { "type": "array", "items": { "type": "string" } },
        "contexts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "outcomes": { "type": "array" },
    "failures": { "type": "array" },
    "claimStatus": { "enum": ["exploratory", "confirmatory", "null", "invalid"] },
    "confirmatoryPlan": { "type": "object" },
    "confirmatoryAnalysis": { "type": "object" },
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  }
}
